{
  "name": "pixvitta",
  "productName": "Pixvitta",
  "version": "1.2.7",
  "description": "A lightweight desktop image and video viewer.",
  "desktopName": "pixvitta.desktop",
  "private": true,
  "author": "Raul Rodrigues",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raulferrodrigues/pixvitta.git"
  },
  "bugs": {
    "url": "https://github.com/raulferrodrigues/pixvitta/issues"
  },
  "homepage": "https://github.com/raulferrodrigues/pixvitta#readme",
  "main": "dist-electron/main/main.js",
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "icon:design": "node scripts/design-icon.mjs",
    "icon:generate": "node scripts/generate-icon.mjs stable",
    "icon:generate:nightly": "node scripts/generate-icon.mjs nightly",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build:electron": "esbuild src/main/main.ts src/preload/preload.ts --bundle --platform=node --external:electron --external:electron-updater --format=cjs --outdir=dist-electron",
    "electron:dev": "pnpm build:electron && concurrently -k \"pnpm dev\" \"wait-on tcp:5173 && env -u ELECTRON_RUN_AS_NODE PIXVITTA_BUILD_FLAVOR=dev VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "test": "node scripts/run-tests.mjs",
    "test:stage": "node scripts/run-playwright.mjs stage",
    "test:e2e": "node scripts/run-playwright.mjs e2e",
    "dev:stage": "vite --config vite.stage.config.mts",
    "verify": "node scripts/verify.mjs",
    "app": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/support/driver.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "build": "vite build && pnpm build:electron",
    "validate": "pnpm test && pnpm typecheck && pnpm build",
    "dist": "pnpm dist:mac",
    "dist:mac": "pnpm icon:generate && pnpm build && electron-builder --mac dmg zip --publish never",
    "dist:linux": "pnpm icon:generate && pnpm build && node scripts/build-linux.mjs stable",
    "dist:linux:nightly": "pnpm icon:generate:nightly && pnpm build && node scripts/build-linux.mjs nightly",
    "dist:deb": "pnpm icon:generate && pnpm build && node scripts/build-linux.mjs stable deb",
    "dist:deb:nightly": "pnpm icon:generate:nightly && pnpm build && node scripts/build-linux.mjs nightly deb",
    "dist:dir": "pnpm icon:generate && pnpm build && electron-builder --mac dir",
    "gt:generate": "gt generate",
    "release:check": "node scripts/verify-release-env.mjs",
    "release:mac": "pnpm release:check && pnpm validate && pnpm dist"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-virtual": "^3.14.25",
    "electron-updater": "^6.8.11",
    "gt-react": "^11.4.16",
    "lucide-react": "^1.66.0",
    "parse5": "8.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "gt": "^2.26.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.raulrodrigues.pixvitta",
    "productName": "Pixvitta",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "fileAssociations": [
        {
          "ext": [
            "jpg",
            "jpeg",
            "png",
            "gif",
            "webp",
            "bmp",
            "avif",
            "svg",
            "ico"
          ],
          "name": "Pixvitta Image",
          "role": "Viewer",
          "rank": "Default"
        },
        {
          "ext": [
            "mp4",
            "m4v",
            "mov",
            "webm",
            "ogv",
            "ogg"
          ],
          "name": "Pixvitta Video",
          "role": "Viewer",
          "rank": "Default"
        }
      ]
    },
    "linux": {
      "category": "Graphics;AudioVideo;Video",
      "icon": "build/icons",
      "desktop": {
        "entry": {
          "StartupWMClass": "pixvitta"
        }
      },
      "extraResources": [
        {
          "from": "build/runtime-icon.png",
          "to": "icon.png"
        }
      ],
      "maintainer": "Raul Rodrigues <48070394+raulferrodrigues@users.noreply.github.com>",
      "target": [
        "AppImage"
      ],
      "mimeTypes": [
        "image/jpeg",
        "image/png",
        "image/gif",
        "image/webp",
        "image/bmp",
        "image/avif",
        "image/svg+xml",
        "image/x-icon",
        "video/mp4",
        "video/x-m4v",
        "video/quicktime",
        "video/webm",
        "video/ogg"
      ]
    },
    "appImage": {
      "artifactName": "Pixvitta.AppImage"
    },
    "deb": {
      "artifactName": "Pixvitta-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Pixvitta-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "raulferrodrigues",
        "repo": "pixvitta"
      }
    ],
    "electronUpdaterCompatibility": ">= 2.16"
  }
}
